    "attacker": "independent MobileNetV3-Small per dataset",
    "common_security_layer": "same AES-256-GCM tile-encryption implementation; residual-leakage endpoint uses neutral masking at selected tile locations",
    "statistics": {
      "bootstrap_resamples": 2000,
      "paired_sign_flip_permutations": 10000,
      "multiple_testing": "Holm"
    }
  },
  "new_representative_baselines": {
    "log_roi_inspired": {
      "basis": "Protocol-normalized reproduction of the Laplacian-of-Gaussian ROI-selection principle used by Zhang et al. (Complex & Intelligent Systems, 2024, DOI 10.1007/s40747-023-01258-2).",
      "implementation": "tiles ranked by mean absolute LoG response (sigma=1.0); original chaotic cipher not reproduced because cipher is held constant across same-condition selectors."
    },
    "cam_priority": {
      "basis": "Alternative annotation-free model-derived Class Activation Mapping priority map (Zhou et al., CVPR 2016, DOI 10.1109/CVPR.2016.319).",
      "implementation": "CAM from exact study ResNet-18 final layer4 features and target-class FC weights; argmax class on unmasked image."
    }
  },
  "closest_recent_annotation_dependent_methods_not_directly_retrained": [
    {
      "paper": "Priyanka et al., YOLO-based ROI selection for joint encryption and compression of medical images with reconstruction through super-resolution network, FGCS 150 (2024) 1-9, DOI 10.1016/j.future.2023.08.018",
      "reason": "YOLOv7 ROI detector requires task-specific ROI detection targets not consistently available across the three study datasets."
    },
    {
      "paper": "Singh et al., DeepENC: Deep Learning-Based ROI Selection for Encryption of Medical Images Through Key Generation With Multimodal Information Fusion, IEEE TCE 70(3) (2024) 6149-6156, DOI 10.1109/TCE.2024.3406963",
      "reason": "UNet3+ ROI segmentation requires ROI masks not consistently available across the three study datasets."
    }
  ],
